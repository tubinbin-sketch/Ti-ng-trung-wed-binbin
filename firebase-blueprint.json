{
  "entities": {
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Authenticated teacher profile managed via Google Sign-In and allowlist custom claims.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the teacher" },
        "email": { "type": "string", "format": "email", "description": "Teacher Google email" },
        "displayName": { "type": "string", "description": "Teacher display name" },
        "role": { "type": "string", "enum": ["teacher"], "description": "Fixed role marker" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "updatedAt"]
    },
    "JoinCodeMapping": {
      "title": "JoinCodeMapping",
      "description": "Unique random class join code mapping to a specific classId.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "Target classroom document ID" },
        "teacherUid": { "type": "string", "description": "Owner teacher Firebase UID" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "teacherUid", "createdAt"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "A Chinese HSK classroom owned by a specific teacher.",
      "type": "object",
      "properties": {
        "teacherUid": { "type": "string", "description": "Owner teacher Firebase UID" },
        "name": { "type": "string", "description": "Classroom display name" },
        "hskLevel": { "type": "string", "description": "Target HSK level (e.g. HSK 1-3)" },
        "joinCode": { "type": "string", "description": "Random 6+ char class join code issued to students" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherUid", "name", "hskLevel", "joinCode"]
    },
    "ClassStudent": {
      "title": "ClassStudent",
      "description": "Student enrolled in a specific classroom.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string", "description": "Bound Firebase Auth UID of the student" },
        "name": { "type": "string", "description": "Student full name" },
        "studentCode": { "type": "string", "description": "Teacher-issued random student code (e.g. HV-8K4M9P)" },
        "hskLevel": { "type": "string", "description": "Student HSK level" },
        "totalPoints": { "type": "number", "description": "Latest score out of 100" },
        "vocabScore": { "type": "string" },
        "writingScore": { "type": "string" },
        "quizScore": { "type": "string" },
        "status": { "type": "string" },
        "feedback": { "type": "string" },
        "timeSeconds": { "type": "number" },
        "streak": { "type": "number" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "studentCode", "joinedAt"]
    },
    "ClassDeck": {
      "title": "ClassDeck",
      "description": "Vocabulary slide deck curated by the class teacher.",
      "type": "object",
      "properties": {
        "teacherUid": { "type": "string" },
        "title": { "type": "string" },
        "slides": { "type": "array", "description": "Array of VocabSlide items" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherUid", "title", "slides", "updatedAt"]
    },
    "ClassAssignment": {
      "title": "ClassAssignment",
      "description": "Sanitized homework or quiz package assigned to a classroom (without secret answer keys).",
      "type": "object",
      "properties": {
        "teacherUid": { "type": "string" },
        "sessionNumber": { "type": "number" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "dueDate": { "type": "string" },
        "multipleChoiceList": { "type": "array" },
        "sentenceOrderingList": { "type": "array" },
        "essayList": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherUid", "title", "updatedAt"]
    },
    "AssignmentAnswerKey": {
      "title": "AssignmentAnswerKey",
      "description": "Private teacher-only answer key for server-side grading.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "teacherUid": { "type": "string" },
        "multipleChoiceAnswers": { "type": "object" },
        "sentenceOrderingAnswers": { "type": "object" },
        "essayModels": { "type": "object" },
        "maxAttempts": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assignmentId", "teacherUid", "updatedAt"]
    },
    "AssignmentSubmission": {
      "title": "AssignmentSubmission",
      "description": "Server-graded student homework submission.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string", "description": "Must match authenticated student UID" },
        "studentCode": { "type": "string" },
        "studentName": { "type": "string" },
        "assignmentId": { "type": "string" },
        "score": { "type": "number" },
        "attemptCount": { "type": "number" },
        "answers": { "type": "object" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentUid", "assignmentId", "score", "answers", "submittedAt"]
    },
    "LeaderboardEntrySummary": {
      "title": "LeaderboardEntrySummary",
      "description": "Sanitized class leaderboard entry written by the server after grading.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string" },
        "studentCode": { "type": "string" },
        "name": { "type": "string" },
        "hskLevel": { "type": "string" },
        "score": { "type": "number" },
        "timeSeconds": { "type": "number" },
        "streak": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentUid", "name", "score", "updatedAt"]
    },
    "UserEnrollmentProfile": {
      "title": "UserEnrollmentProfile",
      "description": "Server-managed record of classes a student is enrolled in.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "enrolledClassIds": { "type": "array" },
        "activeClassId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "enrolledClassIds", "updatedAt"]
    },
    "UserSrsRecord": {
      "title": "UserSrsRecord",
      "description": "Personal flashcard SRS progress and learned status for a student.",
      "type": "object",
      "properties": {
        "wordId": { "type": "string" },
        "hanzi": { "type": "string" },
        "pinyin": { "type": "string" },
        "rating": { "type": "string", "enum": ["forgot", "hard", "good", "mastered"] },
        "intervalDays": { "type": "number" },
        "intervalLabel": { "type": "string" },
        "nextReviewAt": { "type": "string", "format": "date-time" },
        "inMistakeBook": { "type": "boolean" },
        "learned": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["wordId", "hanzi", "learned", "updatedAt"]
    },
    "AiDailyUsage": {
      "title": "AiDailyUsage",
      "description": "Server-managed daily AI call counter per user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "date": { "type": "string" },
        "count": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "date", "count", "updatedAt"]
    }
  },
  "firestore": {
    "/teachers/{uid}": {
      "schema": { "$ref": "#/entities/TeacherProfile" },
      "description": "Teacher profiles keyed by Firebase Auth UID."
    },
    "/joinCodes/{code}": {
      "schema": { "$ref": "#/entities/JoinCodeMapping" },
      "description": "Unique random class join codes mapping to classId."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Classrooms owned by teachers."
    },
    "/classes/{classId}/students/{studentUid}": {
      "schema": { "$ref": "#/entities/ClassStudent" },
      "description": "Enrolled students in a class keyed by studentUid (or teacher-created slot)."
    },
    "/classes/{classId}/decks/{deckId}": {
      "schema": { "$ref": "#/entities/ClassDeck" },
      "description": "Vocabulary slide decks for a classroom."
    },
    "/classes/{classId}/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/ClassAssignment" },
      "description": "Sanitized assignments published to a classroom (questions only)."
    },
    "/classes/{classId}/answerKeys/{assignmentId}": {
      "schema": { "$ref": "#/entities/AssignmentAnswerKey" },
      "description": "Private teacher-only answer keys for assignments."
    },
    "/classes/{classId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Server-graded student assignment submissions."
    },
    "/classes/{classId}/leaderboard/{studentUid}": {
      "schema": { "$ref": "#/entities/LeaderboardEntrySummary" },
      "description": "Server-written class leaderboard summary readable by class members."
    },
    "/users/{studentUid}": {
      "schema": { "$ref": "#/entities/UserEnrollmentProfile" },
      "description": "Server-managed student class enrollment profile."
    },
    "/users/{studentUid}/srs/{wordId}": {
      "schema": { "$ref": "#/entities/UserSrsRecord" },
      "description": "Private student flashcard SRS and learned word progress."
    },
    "/aiUsage/{usageId}": {
      "schema": { "$ref": "#/entities/AiDailyUsage" },
      "description": "Server-only daily AI quota counters."
    }
  }
}
