# ============================================================================
# HANU × 阮文受 — HSK 3.0 Chinese Learning & Classroom Platform
# Copy this file to .env and fill in your credentials
# ============================================================================

# 1. Server-side Gemini AI Key (used by server.ts for /api/hanzi/enrich, /api/hanzi/suggest, /api/binbin/chat)
GEMINI_API_KEY=

# 2. Firebase Client SDK Configuration (optional override if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# 3. Firebase Admin SDK Configuration (used by server.ts to verify Authorization: Bearer <idToken>)
# On Google Cloud Run, Application Default Credentials (ADC) are used automatically if omitted.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# 4. Daily AI Call Quota per Authenticated User UID (defaults to 60 calls/day/uid)
AI_DAILY_LIMIT=60

# 5. Comma-separated list of trusted Origins for AI endpoints in production
ALLOWED_ORIGINS=http://localhost:3000

# 6. Server Port (Cloud Run injects PORT=8080 or 3000)
PORT=3000
