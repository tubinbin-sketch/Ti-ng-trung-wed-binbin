# ============================================================================
# HANU × 阮文受 — HSK 3.0 Chinese Learning & Classroom Platform
# Copy this file to .env and fill in your credentials
# ============================================================================

# 1. Server-side Gemini AI Key (used by server.ts for /api/hanzi/enrich, /api/hanzi/suggest, /api/binbin/chat)
GEMINI_API_KEY=
# Optional: override the Gemini models. Defaults try current GA models in order
# and fall back automatically (chat: gemini-3.8-flash → 3.6-flash → 3.5-flash-lite → 2.5-flash;
# lookups: gemini-3.5-flash-lite → 3.1-flash-lite → 3.8-flash → 2.5-flash).
# GEMINI_CHAT_MODEL=
# GEMINI_FAST_MODEL=

# 2. Firebase Client SDK Configuration (optional override if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# 3. Firebase Admin SDK Configuration (used by server.ts to verify Authorization: Bearer <idToken>)
# On Google Cloud Run, Application Default Credentials (ADC) are used automatically if omitted.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# 4. Daily AI Call Quota per Authenticated User UID (defaults to 60 calls/day/uid)
AI_DAILY_LIMIT=60

# 5. Teacher Email Allowlist (comma-separated verified emails allowed to bootstrap teacher role claim)
# Required in production; server fails closed (returns []) if unset.
TEACHER_EMAIL_ALLOWLIST=teacher@example.edu.vn

# 6. Homework Submission, App Check & Multi-Instance Quota/Rate-Limit Hardening
MAX_SUBMISSION_ATTEMPTS=1
# Required at build time (`vite build`) and runtime when App Check is enforced in production.
# If VITE_RECAPTCHA_ENTERPRISE_SITE_KEY is empty while NODE_ENV=production and ENFORCE_APP_CHECK!=false,
# the client cannot mint X-Firebase-AppCheck tokens and all /api/* requests will fail closed with HTTP 401.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# When NODE_ENV=production, App Check is enforced by default (fail-closed) unless explicitly overridden with ENFORCE_APP_CHECK=false
ENFORCE_APP_CHECK=true
# Fail closed (503) if Firestore AI quota or shared rate-limit store is unreachable.
# On NODE_ENV=production, fail-closed is ALWAYS enforced regardless of env overrides.
STRICT_FIRESTORE_AI_QUOTA=true
STRICT_SHARED_RATE_LIMIT=true
# Secret pepper used to HMAC-SHA256 hash IP addresses and UIDs in rateLimits/* (never store raw IPs)
RATE_LIMIT_HMAC_SECRET=

# 7. Comma-separated list of trusted Origins for AI endpoints in production
ALLOWED_ORIGINS=http://localhost:3000

# 8. Server Port (Cloud Run injects PORT=8080 or 3000)
PORT=3000
