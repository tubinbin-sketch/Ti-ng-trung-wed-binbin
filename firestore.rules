rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.role == 'teacher';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId));
    }

    function isClassTeacher(classId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        classDoc(classId).data.teacherUid == request.auth.uid;
    }

    function isEnrolledStudent(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid));
    }

    function isClassMember(classId) {
      return isClassTeacher(classId) || isEnrolledStudent(classId);
    }

    // ===============================================================
    // 1. Teachers Collection: /teachers/{uid}
    // ===============================================================
    match /teachers/{uid} {
      allow get: if isValidId(uid) && isOwner(uid) && isTeacher();
      allow list: if false;
      allow create: if isValidId(uid) &&
        isOwner(uid) &&
        isTeacher() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'updatedAt', 'createdAt']) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'teacher' &&
        isValidString(request.resource.data.displayName, 1, 120);
      allow update: if isValidId(uid) &&
        isOwner(uid) &&
        isTeacher() &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'updatedAt', 'createdAt']) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == 'teacher' &&
        isValidString(request.resource.data.displayName, 1, 120);
      allow delete: if false;
    }

    // ===============================================================
    // 2. Join Codes Collection: /joinCodes/{code}
    // ===============================================================
    match /joinCodes/{code} {
      // Student class joining is mediated 100% by the server (`POST /api/classes/join`) using Admin SDK.
      // Direct client `get` is restricted to verified teachers checking code uniqueness.
      allow get: if isTeacher() && isValidId(code);
      allow list: if false;
      allow create: if isTeacher() &&
        isValidId(code) &&
        code.size() >= 6 &&
        !exists(/databases/$(database)/documents/joinCodes/$(code)) &&
        request.resource.data.keys().hasOnly(['classId', 'teacherUid', 'createdAt']) &&
        request.resource.data.keys().hasAll(['classId']) &&
        isValidString(request.resource.data.classId, 1, 128) &&
        isClassTeacher(request.resource.data.classId);
      allow update: if false;
      allow delete: if isTeacher() &&
        isValidId(code) &&
        isClassTeacher(resource.data.classId);
    }

    // ===============================================================
    // 3. Classes Collection: /classes/{classId}
    // ===============================================================
    match /classes/{classId} {
      // Only members of the class (owning teacher or enrolled student) can get a class document.
      allow get: if isValidId(classId) && isClassMember(classId);
      // Only the owning teacher can list their own classes.
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher() &&
        isValidId(classId) &&
        request.resource.data.keys().hasOnly([
          'id',
          'teacherUid',
          'teacherName',
          'name',
          'hskLevel',
          'joinCode',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.teacherUid == request.auth.uid &&
        isValidString(request.resource.data.name, 1, 160) &&
        isValidString(request.resource.data.hskLevel, 1, 40) &&
        isValidString(request.resource.data.joinCode, 6, 32);

      allow update: if isTeacher() &&
        isValidId(classId) &&
        request.resource.data.keys().hasOnly([
          'id',
          'teacherUid',
          'teacherName',
          'name',
          'hskLevel',
          'joinCode',
          'createdAt',
          'updatedAt'
        ]) &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        isValidString(request.resource.data.name, 1, 160) &&
        isValidString(request.resource.data.hskLevel, 1, 40) &&
        isValidString(request.resource.data.joinCode, 6, 32);

      allow delete: if isTeacher() &&
        isValidId(classId) &&
        resource.data.teacherUid == request.auth.uid;

      // =============================================================
      // 3a. Students Subcollection: /classes/{classId}/students/{studentUid}
      // =============================================================
      match /students/{studentUid} {
        allow get: if isValidId(classId) &&
          isValidId(studentUid) &&
          (isClassTeacher(classId) || isOwner(studentUid));
        // Only the teacher of the class can list the student roster.
        allow list: if isValidId(classId) && isClassTeacher(classId);

        // Students CANNOT create their own student record (server POST /api/classes/join or teacher slot creation only).
        allow create: if isValidId(classId) &&
          isValidId(studentUid) &&
          isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly([
            'id',
            'studentUid',
            'studentCode',
            'name',
            'hskLevel',
            'joinedAt',
            'vocabScore',
            'writingScore',
            'quizScore',
            'totalPoints',
            'status',
            'feedback',
            'reviewWords',
            'timeSeconds',
            'streak',
            'lastSubmittedAt',
            'updatedAt'
          ]) &&
          isValidString(request.resource.data.name, 1, 120) &&
          isValidString(request.resource.data.studentCode, 6, 40);

        // Students can ONLY update their own 'name' field; teachers can update student records in their class.
        allow update: if isValidId(classId) &&
          isValidId(studentUid) &&
          (
            (isClassTeacher(classId) &&
              request.resource.data.keys().hasOnly([
                'id',
                'studentUid',
                'studentCode',
                'name',
                'hskLevel',
                'joinedAt',
                'vocabScore',
                'writingScore',
                'quizScore',
                'totalPoints',
                'status',
                'feedback',
                'reviewWords',
                'timeSeconds',
                'streak',
                'lastSubmittedAt',
                'updatedAt'
              ]) &&
              isValidString(request.resource.data.name, 1, 120) &&
              isValidString(request.resource.data.studentCode, 6, 40)) ||
            (isOwner(studentUid) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
              isValidString(request.resource.data.name, 1, 120))
          );

        allow delete: if isValidId(classId) &&
          isValidId(studentUid) &&
          isClassTeacher(classId);
      }

      // =============================================================
      // 3a-locks. Server-Only Student Code Claim Locks: /classes/{classId}/studentCodeLocks/{studentCode}
      // =============================================================
      match /studentCodeLocks/{studentCode} {
        allow read, write: if false;
      }

      // =============================================================
      // 3b. Decks Subcollection: /classes/{classId}/decks/{deckId}
      // =============================================================
      match /decks/{deckId} {
        allow read: if isValidId(classId) && isValidId(deckId) && isClassMember(classId);
        allow create, update: if isValidId(classId) &&
          isValidId(deckId) &&
          isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly([
            'id',
            'title',
            'hskLevel',
            'teacherUid',
            'slides',
            'updatedAt'
          ]) &&
          request.resource.data.teacherUid == request.auth.uid &&
          request.resource.data.slides is list;
        allow delete: if isValidId(classId) && isValidId(deckId) && isClassTeacher(classId);
      }

      // =============================================================
      // 3c. Assignments Subcollection: /classes/{classId}/assignments/{assignmentId}
      // =============================================================
      match /assignments/{assignmentId} {
        allow read: if isValidId(classId) && isValidId(assignmentId) && isClassMember(classId);
        allow create, update: if isValidId(classId) &&
          isValidId(assignmentId) &&
          isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly([
            'id',
            'title',
            'fileName',
            'fileType',
            'sessionTitle',
            'sessionNumber',
            'uploadedAt',
            'dueDate',
            'teacherName',
            'teacherUid',
            'rawContent',
            'multipleChoiceList',
            'sentenceOrderingList',
            'essayList',
            'questions',
            'hskLevel',
            'description',
            'updatedAt'
          ]) &&
          request.resource.data.teacherUid == request.auth.uid &&
          isValidString(request.resource.data.title, 1, 240) &&
          !('answerKey' in request.resource.data);
        allow delete: if isValidId(classId) && isValidId(assignmentId) && isClassTeacher(classId);
      }

      // =============================================================
      // 3d. Answer Keys Subcollection: /classes/{classId}/answerKeys/{assignmentId}
      // =============================================================
      match /answerKeys/{assignmentId} {
        // Strictly teacher-only! Students can never read or write answer keys.
        allow read: if isValidId(classId) && isValidId(assignmentId) && isClassTeacher(classId);
        allow create, update: if isValidId(classId) &&
          isValidId(assignmentId) &&
          isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly([
            'assignmentId',
            'teacherUid',
            'multipleChoiceAnswers',
            'sentenceOrderingAnswers',
            'essayModels',
            'maxAttempts',
            'updatedAt',
            'answers'
          ]) &&
          request.resource.data.teacherUid == request.auth.uid;
        allow delete: if isValidId(classId) && isValidId(assignmentId) && isClassTeacher(classId);
      }

      // =============================================================
      // 3d-starts. Server-Only Assignment Start Timestamps: /classes/{classId}/assignmentStarts/{startId}
      // =============================================================
      match /assignmentStarts/{startId} {
        allow read, write: if false;
      }

      // =============================================================
      // 3e. Submissions Subcollection: /classes/{classId}/submissions/{submissionId}
      // =============================================================
      match /submissions/{submissionId} {
        // Students can ONLY read their own submissions; Teacher can read all submissions in their class.
        allow read: if isValidId(classId) &&
          isValidId(submissionId) &&
          (isClassTeacher(classId) || (isSignedIn() && resource.data.studentUid == request.auth.uid));

        // Clients CANNOT create, update, or delete submissions directly (server POST /api/submissions only).
        allow create, update, delete: if false;
      }

      // =============================================================
      // 3f. Leaderboard Summary Subcollection: /classes/{classId}/leaderboard/{studentUid}
      // =============================================================
      match /leaderboard/{studentUid} {
        allow read: if isValidId(classId) && isValidId(studentUid) && isClassMember(classId);
        // Clients CANNOT write directly to leaderboard (server POST /api/submissions only).
        allow create, update, delete: if false;
      }
    }

    // ===============================================================
    // 4. Student Profile & Private SRS Progress: /users/{studentUid}
    // ===============================================================
    match /users/{studentUid} {
      allow get: if isValidId(studentUid) && isOwner(studentUid);
      allow list, create, update, delete: if false;

      match /srs/{wordId} {
        allow read: if isValidId(studentUid) && isValidId(wordId) && isOwner(studentUid);
        allow create, update: if isValidId(studentUid) &&
          isValidId(wordId) &&
          isOwner(studentUid) &&
          request.resource.data.keys().hasOnly([
            'wordId',
            'hanzi',
            'pinyin',
            'meaning',
            'learned',
            'intervalDays',
            'easeFactor',
            'repetitions',
            'dueAt',
            'nextReviewAt',
            'lastReviewedAt',
            'updatedAt'
          ]) &&
          isValidString(request.resource.data.wordId, 1, 120) &&
          isValidString(request.resource.data.hanzi, 1, 40) &&
          request.resource.data.learned is bool;
        allow delete: if isValidId(studentUid) && isValidId(wordId) && isOwner(studentUid);
      }
    }

    // ===============================================================
    // 5. Server-Only AI Usage Quota & Shared Rate Limits: /aiUsage/{usageId}, /rateLimits/{bucketId}
    // ===============================================================
    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    match /rateLimits/{bucketId} {
      allow read, write: if false;
    }

    // ===============================================================
    // 6. Default Deny All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
